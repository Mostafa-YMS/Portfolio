# Environment variables for portfolio contact form
# Copy to .env.local and fill with real values

# Site URL (required for canonical URLs in production)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Contact form submission (server-side only - never expose to client)
# Option 1: Resend
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_FORM_FROM_EMAIL=contact@yourdomain.com
CONTACT_FORM_TO_EMAIL=your-email@example.com

# Option 2: SendGrid
# SENDGRID_API_KEY=SG.xxxxxxxxx
# CONTACT_FORM_FROM_EMAIL=contact@yourdomain.com
# CONTACT_FORM_TO_EMAIL=your-email@example.com

# Option 3: Custom webhook
# CONTACT_FORM_WEBHOOK_URL=https://your-webhook.example.com/submit

# Spam protection
# TURNSTILE_SECRET_KEY=0x4AAAAAAAAAA... (Cloudflare Turnstile)
# RECAPTCHA_SECRET_KEY=6Lc... (Google reCAPTCHA)
# HONEYPOT_FIELD_NAME=website (custom honeypot field name)

# Rate limiting (optional)
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=3600000
